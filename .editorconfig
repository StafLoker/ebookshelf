#############
## General ##
#############

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

#############
## Docs    ##
#############

[*.md]
trim_trailing_whitespace = false

###################
## Data / Config ##
###################

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.xml]
indent_size = 4

[Makefile]
indent_style = tab

######################
## Windows-specific ##
######################

[*.{bat,cmd}]
end_of_line = crlf
